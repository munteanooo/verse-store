existingSecret: verse-store-secrets

image:
  # Replace with a published immutable SHA tag, for example sha-0123456789abcdef.
  tag: sha-replace-with-published-commit
  digest: ""
  pullPolicy: IfNotPresent

mailpit:
  enabled: true

ingress:
  enabled: true
  className: nginx
  tlsSecretName: verse-local-tls
  app:
    host: verse.local
  keycloak:
    host: auth.verse.local
  mailpit:
    enabled: true
    host: mail.verse.local

# kind's default CNI does not enforce NetworkPolicy. Enable only with a capable CNI.
networkPolicy:
  enabled: false
