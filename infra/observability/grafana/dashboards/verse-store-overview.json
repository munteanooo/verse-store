{
  "uid":"verse-overview","title":"Verse Store Overview","tags":["verse-store"],"timezone":"browser","schemaVersion":41,"version":1,"refresh":"15s",
  "templating":{"list":[{"name":"environment","type":"query","datasource":{"type":"prometheus","uid":"prometheus"},"query":{"query":"label_values(process_uptime_seconds{application=\"verse-store\"}, environment)"},"current":{"text":"local-kind","value":"local-kind"}}]},
  "panels":[
    {"id":1,"type":"stat","title":"Uptime","gridPos":{"x":0,"y":0,"w":4,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"process_uptime_seconds{application=\"verse-store\",environment=\"$environment\"}"}],"fieldConfig":{"defaults":{"unit":"s"}}},
    {"id":2,"type":"stat","title":"Requests / second","gridPos":{"x":4,"y":0,"w":4,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(rate(http_server_requests_seconds_count{application=\"verse-store\",environment=\"$environment\"}[5m]))"}]},
    {"id":3,"type":"timeseries","title":"HTTP latency p50 / p95 / p99","gridPos":{"x":8,"y":0,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"legendFormat":"p50","expr":"histogram_quantile(0.50,sum by(le)(rate(http_server_requests_seconds_bucket{application=\"verse-store\",environment=\"$environment\"}[5m])))"},{"legendFormat":"p95","expr":"histogram_quantile(0.95,sum by(le)(rate(http_server_requests_seconds_bucket{application=\"verse-store\",environment=\"$environment\"}[5m])))"},{"legendFormat":"p99","expr":"histogram_quantile(0.99,sum by(le)(rate(http_server_requests_seconds_bucket{application=\"verse-store\",environment=\"$environment\"}[5m])))"}],"fieldConfig":{"defaults":{"unit":"s"}}},
    {"id":4,"type":"timeseries","title":"HTTP status rates","gridPos":{"x":16,"y":0,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"legendFormat":"2xx","expr":"sum(rate(http_server_requests_seconds_count{application=\"verse-store\",status=~\"2..\"}[5m]))"},{"legendFormat":"4xx","expr":"sum(rate(http_server_requests_seconds_count{application=\"verse-store\",status=~\"4..\"}[5m]))"},{"legendFormat":"5xx","expr":"sum(rate(http_server_requests_seconds_count{application=\"verse-store\",status=~\"5..\"}[5m]))"}]},
    {"id":5,"type":"timeseries","title":"JVM heap / non-heap","gridPos":{"x":0,"y":8,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"legendFormat":"{{area}}","expr":"sum by(area)(jvm_memory_used_bytes{application=\"verse-store\"})"}],"fieldConfig":{"defaults":{"unit":"bytes"}}},
    {"id":6,"type":"timeseries","title":"GC pause rate","gridPos":{"x":8,"y":8,"w":4,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(rate(jvm_gc_pause_seconds_sum{application=\"verse-store\"}[5m]))"}],"fieldConfig":{"defaults":{"unit":"s"}}},
    {"id":7,"type":"timeseries","title":"Process CPU","gridPos":{"x":12,"y":8,"w":4,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"process_cpu_usage{application=\"verse-store\"}"}],"fieldConfig":{"defaults":{"unit":"percentunit"}}},
    {"id":8,"type":"timeseries","title":"HikariCP connections","gridPos":{"x":16,"y":8,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"legendFormat":"active","expr":"hikaricp_connections_active{application=\"verse-store\"}"},{"legendFormat":"idle","expr":"hikaricp_connections_idle{application=\"verse-store\"}"},{"legendFormat":"max","expr":"hikaricp_connections_max{application=\"verse-store\"}"}]},
    {"id":9,"type":"timeseries","title":"Pod restarts","gridPos":{"x":0,"y":16,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"legendFormat":"{{pod}}","expr":"kube_pod_container_status_restarts_total{namespace=\"verse-dev\",container=\"app\"}"}]},
    {"id":10,"type":"stat","title":"Pod readiness","gridPos":{"x":12,"y":16,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"min(kube_pod_status_ready{namespace=\"verse-dev\",condition=\"true\",pod=~\"verse-[0-9a-f]+-.*\"})"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"Not Ready","color":"red"},"1":{"text":"Ready","color":"green"}}}]}}}
  ]
}
